---
import LegalPage from '../../components/LegalPage.astro';
import LegacyRedirect from '../../components/LegacyRedirect.astro';
import { isLegalPage, isLocale } from '../../i18n';
import { staticPages } from '../../lib/pages.mjs';

export const getStaticPaths = () => staticPages('en');

const locale = Astro.currentLocale;
if (!isLocale(locale) || locale !== 'en') throw new Error(`Expected en, got ${locale}`);
const { kind, redirect } = Astro.props;
const legalKind = isLegalPage(kind) ? kind : null;
const legacyPage =
  redirect?.page === 'privacy' || redirect?.page === 'imprint' ? redirect.page : null;
const hash = typeof redirect?.hash === 'string' ? redirect.hash : undefined;
if (!legalKind && !legacyPage) throw new Error(`Unexpected page ${Astro.params.page}`);
---

{legalKind ? (
  <LegalPage locale={locale} kind={legalKind} />
) : (
  legacyPage && <LegacyRedirect locale={locale} page={legacyPage} hash={hash} />
)}
