---
import { getEntry } from 'astro:content';
import { site } from '../config.mjs';
import { parseLegalBody } from '../lib/legal.mjs';
import { renderLegalText } from '../lib/html.mjs';
import type { Locale } from '../i18n';
import Base from './Base.astro';

interface Props {
  locale: Locale;
  kind: 'privacy' | 'imprint' | 'terms';
}

const { locale, kind } = Astro.props;
type LegalBlock = { type: 'h3'; text: string; id?: string } | { type: 'p'; text: string };
type LegalSection = { id?: string; title: string; blocks: LegalBlock[] };
const entry = await getEntry('legal', `${locale}/${kind}`);
if (!entry?.body) throw new Error(`Missing legal markdown ${locale}/${kind}`);
const sections = parseLegalBody(entry.body) as LegalSection[];
---

<Base
  locale={locale}
  route={kind}
  title={`${entry.data.title} | ${site.name}`}
  description={kind === 'imprint' ? entry.data.intro : `${entry.data.title} | ${site.name}`}
>
  <main id="main" class="container legal-page">
    <h1>{entry.data.title}</h1>
    {kind === 'imprint' && <h2 class="legal-statute">{entry.data.intro}</h2>}
    {entry.data.note && <p class="legal-note">{entry.data.note}</p>}
    {sections.map((section, index) => {
      const id = section.id ?? `legal-${index}`;
      return (
        <section aria-labelledby={id}>
          <h2 id={id}>{section.title}</h2>
          {section.blocks.map((block) =>
            block.type === 'h3' ? (
              block.id ? (
                <h3 id={block.id}>{block.text}</h3>
              ) : (
                <h3>{block.text}</h3>
              )
            ) : (
              <p set:html={renderLegalText(block.text)} />
            ),
          )}
        </section>
      );
    })}
    <p class="small">{entry.data.updated}</p>
  </main>
</Base>
