---
import { Icon } from 'astro-icon/components';
import '../styles.css';
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from 'astro:i18n';
import { hasPage, languages, site, slugFor } from '../config.mjs';
import { hashRedirect } from '../lib/html.mjs';
import { isLocale, otherLocale, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  route?: string;
  title: string;
  description?: string;
  variant?: 'page' | 'redirect';
  redirectPage?: 'privacy' | 'imprint';
  redirectHash?: string;
  preserveIncomingHash?: boolean;
}

const {
  locale,
  route = '',
  title,
  description,
  variant = 'page',
  redirectPage,
  redirectHash,
  preserveIncomingHash = false,
} = Astro.props;
const other = otherLocale(locale);
const t = useTranslations(locale);
const home = getRelativeLocaleUrl(locale);
const asset = (name: string) => `${import.meta.env.BASE_URL}assets/${name}`;
const localePath = (lang: Locale, page: string) =>
  page ? getRelativeLocaleUrl(lang, slugFor(lang, page)) : getRelativeLocaleUrl(lang);
const absoluteLocalePath = (lang: Locale, page: string) =>
  page ? getAbsoluteLocaleUrl(lang, slugFor(lang, page)) : getAbsoluteLocaleUrl(lang);
const pageKey = variant === 'redirect' ? (redirectPage ?? '') : route;
const hashSuffix = redirectHash ? `#${redirectHash}` : '';
const canonical = absoluteLocalePath(locale, pageKey);
const redirectTarget =
  variant === 'redirect' ? `${localePath(locale, redirectPage ?? '')}${hashSuffix}` : '';
const languageTarget = !route || hasPage(other, route) ? route : '';
const languageHref =
  variant === 'redirect'
    ? `${localePath(other, redirectPage ?? '')}${hashSuffix}`
    : localePath(other, languageTarget);
const localeCodes = languages.filter(isLocale);
const preserved = preserveIncomingHash ? hashRedirect(redirectTarget) : null;
const csp = `default-src 'none'; ${preserved ? preserved.csp : "script-src 'self';"} style-src 'self'; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <script is:inline src={`${import.meta.env.BASE_URL}theme.js`}></script>
    {variant === 'page' && <meta name="description" content={description} />}
    <meta name="color-scheme" content="light dark" />
    {variant === 'redirect' && <meta name="robots" content="noindex" />}
    {variant === 'redirect' && preserveIncomingHash && (
      <script is:inline set:html={preserved?.script} />
    )}
    {variant === 'redirect' &&
      (preserveIncomingHash ? (
        <noscript>
          <meta http-equiv="refresh" content={`0; url=${redirectTarget}`} />
        </noscript>
      ) : (
        <meta http-equiv="refresh" content={`0; url=${redirectTarget}`} />
      ))}
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {variant === 'page' &&
      localeCodes
        .filter((code) => !route || hasPage(code, route))
        .map((code) => (
          <link rel="alternate" hreflang={code} href={absoluteLocalePath(code, route)} />
        ))}
    {variant === 'page' && (
      <link rel="alternate" hreflang="x-default" href={absoluteLocalePath('de', route)} />
    )}
    <link rel="icon" href={asset('app-icon.png')} type="image/png" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t.skip}
    </a>
    <header class="header">
      <div class="container header-inner">
        <a class="brand" href={home}>
          {variant === 'page' && <img src={asset('app-icon.png')} alt="" width="40" height="40" />}
          {site.name}
        </a>
        {variant === 'page' && (
          <nav class="main-nav" aria-label={t.navLabel}>
            <a href={`${home}#concept`}>{t.navConcept}</a>
            <a href={`${home}#features`}>{t.navFeatures}</a>
            <a href={`${home}#plans`}>{t.navPlans}</a>
            <a href={localePath(locale, 'manual')}>{t.navManual}</a>
          </nav>
        )}
        <div class="header-actions">
          <button
            type="button"
            class="theme-toggle"
            data-theme-toggle
            aria-label={t.themeToggle}
            title={t.themeToggle}
          >
            <Icon name="lucide:sun" class="icon theme-icon theme-icon-light" aria-hidden="true" />
            <Icon name="lucide:moon" class="icon theme-icon theme-icon-dark" aria-hidden="true" />
          </button>
          <a
            class="language"
            href={languageHref}
            lang={locale}
            hreflang={other}
            aria-label={t.switchLabel}
            title={t.switchLabel}
          >
            <Icon
              name={locale === 'de' ? 'circle-flags:de' : 'circle-flags:gb'}
              class="language-flag"
              aria-hidden="true"
            />
            {locale.toUpperCase()}
          </a>
        </div>
      </div>
    </header>
    <slot />
    <footer class="footer">
      <div class="container footer-grid">
        <div>
          <a class="brand" href={home}>
            {site.name}
          </a>
          <p>{t.footerClaim}</p>
          <p class="small">
            {t.footerBefore}{' '}
            <Icon name="circle-flags:de" class="footer-flag" role="img" aria-label={t.footerFlag} />{' '}
            {t.footerAfter}
          </p>
        </div>
        <nav aria-label={t.footerLegal}>
          <a href={localePath(locale, 'privacy')}>{t.privacy}</a>
          <a href={localePath(locale, 'imprint')}>{t.imprint}</a>
          <a href={localePath(locale, 'terms')}>{t.terms}</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
