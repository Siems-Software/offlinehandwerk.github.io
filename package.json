  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@iconify-json/circle-flags": "1.2.12",
    "@iconify-json/lucide": "1.2.147",
    "astro": "7.4.1",
    "astro-icon": "1.2.0",
    "axe-core": "4.14.0",
    "cheerio": "1.2.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3"
  }
